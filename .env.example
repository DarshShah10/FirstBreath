# ===== LLM Config (OpenRouter or any OpenAI-compatible endpoint) =====
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=stealth/ox-alpha
# Optional fallback model used when the primary fails / rate-limits
LLM_FALLBACK_MODEL=

# ===== Supabase (Postgres) =====
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=your_supabase_project_url
# Server-side secret key (Settings -> API)
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Optional: direct Postgres connection string (used for schema migrations)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ===== Flask =====
FLASK_DEBUG=False
SECRET_KEY=change_me_in_production

# ===== CORS =====
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app
